{
  "name": "my-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "prebuild": "pnpm run cf-typegen && tsx ./scripts/checkDocs.ts && tsx ./scripts/generateDocsMeta.ts && tsx ./scripts/copyAllDTSFiles.ts && tsx ./scripts/removeHinting.ts",
    "dev": "pnpm run prebuild && next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "pnpm run cf-typegen && eslint .",
    "tsc": "pnpm run cf-typegen && tsc",
    "format": "prettier --write .",
    "db-migrate": "drizzle-kit migrate",
    "db-generate": "drizzle-kit generate",
    "db-docs": "tsx ./scripts/checkDocs.ts --write",
    "cf-preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --port 3000",
    "cf-deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "node --import tsx/esm --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/inconsolata": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@google/genai": "^1.52.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@sentry/nextjs": "^10.74.0",
    "@sentry/vercel-edge": "^10.74.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "6.1.0-beta.168",
    "ace-builds": "^1.44.0",
    "better-auth": "^1.7.5",
    "chalk": "^5.6.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "js-yaml": "^4.3.2",
    "mocha": "^11.8.0",
    "next": "^16.3.5",
    "next-license-list": "^1.0.1",
    "pg": "^8.23.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-ace": "^14.1.0",
    "react-children-utilities": "^2.10.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-cjk-friendly": "^1.2.3",
    "remark-gfm": "^4.0.1",
    "remark-remove-comments": "^1.1.1",
    "swr": "^2.5.1",
    "unist-util-remove": "^4.0.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@my-code/runtime": "workspace:*",
    "@pyodide/webpack-plugin": "^1.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/pako": "^2.0.4",
    "@types/pg": "^8.23.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript/vfs": "^1.6.4",
    "daisyui": "^5.7.38",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "eslint-plugin-react-hooks": "7.0.1",
    "fonteditor-core": "^2.6.3",
    "mdast-util-phrasing": "^4.1.0",
    "pako": "^2.2.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "pyodide": "^0.29.4",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "unified": "^11.0.5",
    "unsandbox": "^1.0.0",
    "webpack-license-plugin": "^4.5.1",
    "wrangler": "^4.132.0"
  }
}
